<!doctype html>
<html lang="en">
<head>
  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.gtag }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.gtag }}');
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{{ title }} • {{ site.name }}</title>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <meta name="description" content="{{ description }}">
</head>
<body data-pagefind-body>
<nav class="nav" style="display:flex;gap:16px;justify-content:center;padding:16px;border-bottom:1px solid #2a2f2c;">
  <a href="/" style="color:#a7a7a7;text-decoration:none;">🌿 Home</a>
  <a href="/blog/" style="color:#a7a7a7;text-decoration:none;">Blog</a>
  <a href="/blog/starter-kit/" style="color:#a7a7a7;text-decoration:none;">Starter Kit</a>
  <a href="/blog/pest-id/" style="color:#a7a7a7;text-decoration:none;">Pest ID</a>
  {% include "search.njk" %}
</nav>
{{ content | safe }}
</body>
</html>
