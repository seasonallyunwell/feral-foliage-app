---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
  <title>Feral Foliage</title>
  <link>https://feralfoliage.com</link>
  <description>Plant care tips, guides, and houseplant recommendations</description>
  <language>en-us</language>
  <lastBuildDate>{{ collections.all | getNewestCollectionItemDate | dateToRfc822 }}</lastBuildDate>
  <atom:link href="https://feralfoliage.com/feed.xml" rel="self" type="application/rss+xml"/>
  {%- for post in collections.all | reverse %}
  {%- if loop.index0 < 20 %}
  <item>
    <title>{{ post.data.title }}</title>
    <link>{{ post.url | absoluteUrl("https://feralfoliage.com") }}</link>
    <description>{{ post.data.description or post.content | striptags | truncate(200) }}</description>
    <pubDate>{{ post.date | dateToRfc822 }}</pubDate>
    <guid>{{ post.url | absoluteUrl("https://feralfoliage.com") }}</guid>
  </item>
  {%- endif %}
  {%- endfor %}
</channel>
</rss>
